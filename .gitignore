# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Local / scratch
*.log
.env
.env.*
tmp/
scratch/
.refresh-tmp/
.claude/
.sie/
PROGRESS.md

# Caches with TTL — not worth git history (scripts fork audit 2026-06-17)
metrics/gh-api-cache.json
metrics/l0-cache.json

# Python bytecode
__pycache__/
*.pyc

# Console availability snapshot — TTL probe state, no git history
metrics/availability-cache.json

# Secrets gate (config-spec E6 / Mode B) — defense in depth.
# The companion config repo is separate & private; this block ensures that even if a
# config/secret file is ever dropped into this skill repo, it can never enter git.
secrets/*
!secrets/README.md
!secrets/.gitkeep
*.env
!*.env.template
!env.template
claude.json
.claude.json
*credentials*.json
*.key
*.pem
!*.key.template
!*.pem.template

# --- Data boundary (Skill Repo Spec v1 s9) ---
# metrics/ mixes TOOL and DATA, so the boundary is per-FILE, declared in .dataclass.json -- not
# per-directory. history.jsonl / sweep-*.json / doc-drift-cache.json are TOOL: they describe the
# SKILL (coverage counts, source-catalog diffs, a README hash) and stay public. live-runs.jsonl is
# DATA: it records what happened during REAL research runs, which means it records what the
# operator was researching. It lives in ~/.market-intel-config/data/, resolved by tools/datadir.py.
metrics/live-runs.jsonl
metrics/live-runs.*.jsonl
skills/market-intel/metrics/live-runs.jsonl
skills/market-intel/metrics/live-runs.*.jsonl
!skills/market-intel/metrics/live-runs.jsonl.example
